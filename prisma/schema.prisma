// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENUE_OWNER
  STAFF
  ADMIN
  ADMIN_ACCOUNTING
  CHIN_CHIN_SUPPORT
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  DISABLED
}

enum UserGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum SpaceLayoutStatus {
  DRAFT
  AI_SUGGESTED
  SAVED
  PENDING_CHIN_CHIN_REVIEW
  CHIN_CHIN_CHANGES_REQUESTED
  APPROVED
}

enum VenueDocumentStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum ReservationStatus {
  REQUESTED
  PENDING_VENUE_CONFIRMATION
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
  RESERVED
  CHECK_IN_PENDING
  CHECKED_IN
  SEATED
  CANCELLED_BY_USER
  COMPLETED
  NO_SHOW
  RELEASED
}

enum ReservationType {
  ADVANCE
  LIVE
}

enum PaymentProvider {
  WORLDLINE
  MOCK
}

enum CustomerPaymentMethodStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum ReservationPaymentStatus {
  AUTH_PENDING
  AUTHORIZED
  AUTH_FAILED
  CAPTURE_PENDING
  CAPTURED
  CAPTURE_FAILED
  VOID_PENDING
  VOIDED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  REFUND_FAILED
  FAILED
}

enum PaymentWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum VenueRefundRequestStatus {
  PENDING
  REFUNDED_BY_CHIN_CHIN
  CLOSED_NO_REFUND
}

enum CustomerProblemReportStatus {
  PENDING
  RESPONSE_SENT
  REFUNDED_BY_CHIN_CHIN
  CLOSED_NO_REFUND
  RESOLVED
}

enum LedgerEntryType {
  CUSTOMER_CAPTURE
  CHIN_CHIN_FEE
  VENUE_SHARE
  CUSTOMER_REFUND
  PAYMENT_VOID
  VENUE_PAYOUT_ADJUSTMENT
  CHARGEBACK
}

enum LedgerEntryDirection {
  CREDIT
  DEBIT
}

enum VenuePayoutStatus {
  PENDING
  PROCESSING
  PAID
  CANCELLED
}

enum DrinkBrandType {
  GIN
  WHISKEY
  DRAFT_BEER
  BEER
  COCKTAIL
  WINE
  OTHER
}

enum ChinChinContentType {
  EVENT
  TV_CONTENT
  KARAOKE
  OTHER
}

enum DevicePushPlatform {
  IOS
  ANDROID
  WEB
  MACOS
  WINDOWS
  LINUX
  UNKNOWN
}

enum DevicePushApp {
  CUSTOMER
  VENUE_OWNER
}

enum PushNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String
  firstName       String
  lastName        String
  phoneNumber     String?
  phoneVerifiedAt DateTime?
  age             Int?
  gender          UserGender?
  role            UserRole    @default(VENUE_OWNER)
  status          UserStatus  @default(PENDING_EMAIL_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  venues                  Venue[]
  emailVerificationTokens EmailVerificationToken[]
  phoneVerificationCodes  PhoneVerificationCode[]
  refreshTokens           RefreshToken[]
  spaceLayoutProjects     SpaceLayoutProject[]
  venueDocumentRequests   VenueDocumentRequest[]
  reservations            Reservation[]
  reservationPayments     ReservationPayment[]
  paymentMethods          CustomerPaymentMethod[]
  ledgerEntries           LedgerEntry[]
  venueRefundRequests     VenueRefundRequest[]
  customerProblemReports  CustomerProblemReport[]
  paymentRefundEvents     ReservationPaymentRefund[]
  devicePushTokens        DevicePushToken[]
  pushNotificationLogs    PushNotificationLog[]
  followedVenues          VenueFollower[]

  @@index([status])
  @@map("users")
}

model DevicePushToken {
  id         String             @id @default(uuid())
  userId     String
  token      String             @unique
  provider   String             @default("FCM")
  platform   DevicePushPlatform @default(UNKNOWN)
  app        DevicePushApp
  deviceId   String?
  appVersion String?
  lastSeenAt DateTime           @default(now())
  disabledAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs PushNotificationLog[]

  @@index([userId])
  @@index([app])
  @@index([platform])
  @@index([disabledAt])
  @@map("device_push_tokens")
}

model RegistrationPhoneVerificationCode {
  id          String    @id @default(uuid())
  phoneNumber String
  codeHash    String    @unique
  tokenHash   String?   @unique
  attempts    Int       @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([phoneNumber])
  @@index([expiresAt])
  @@index([verifiedAt])
  @@index([usedAt])
  @@map("registration_phone_verification_codes")
}

model PushNotificationLog {
  id            String                 @id @default(uuid())
  userId        String
  deviceTokenId String?
  title         String
  body          String
  data          Json?
  status        PushNotificationStatus @default(PENDING)
  error         String?
  sentAt        DateTime?
  createdAt     DateTime               @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken DevicePushToken? @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceTokenId])
  @@index([status])
  @@map("push_notification_logs")
}

model Venue {
  id                            String    @id @default(uuid())
  ownerId                       String
  name                          String
  slug                          String    @unique
  businessOib                   String?
  address                       String?
  city                          String?
  country                       String    @default("HR")
  venueType                     String    @default("NIGHT_CAFFE")
  latitude                      Float?
  longitude                     Float?
  profileDescription            String?
  profileImages                 Json      @default("[]")
  isLive                        Boolean   @default(false)
  livePricingBoost              String    @default("DEFAULT")
  isChinChinPanelListed         Boolean   @default(true)
  advanceChinChinTableIds       Json      @default("[]")
  liveChinChinTableIds          Json      @default("[]")
  liveStartedAt                 DateTime?
  liveEndedAt                   DateTime?
  reservationWindowStartMinutes Int       @default(1080)
  reservationWindowEndMinutes   Int       @default(1320)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  owner                  User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spaceLayoutProjects    SpaceLayoutProject[]
  documentRequests       VenueDocumentRequest[]
  reservations           Reservation[]
  chinChinPanel          VenueChinChinPanel?
  reservationPenalties   VenueReservationPenalty[]
  reservationPayments    ReservationPayment[]
  refundRequests         VenueRefundRequest[]
  customerProblemReports CustomerProblemReport[]
  ledgerEntries          LedgerEntry[]
  paymentRefundEvents    ReservationPaymentRefund[]
  payoutBatches          VenuePayoutBatch[]
  followers              VenueFollower[]
  eventNotifications     VenueEventNotification[]

  @@index([ownerId])
  @@map("venues")
}

model VenueFollower {
  id        String   @id @default(uuid())
  userId    String
  venueId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([userId])
  @@index([venueId])
  @@map("venue_followers")
}

model VenueEventNotification {
  id            String    @id @default(uuid())
  venueId       String
  eventId       String
  eventName     String
  eventDay      String
  eventStartsAt String
  eventEndsAt   String
  scheduledFor  DateTime
  sentAt        DateTime?
  skippedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, eventId])
  @@index([scheduledFor, sentAt, skippedAt])
  @@index([venueId])
  @@map("venue_event_notifications")
}

model SpaceLayoutProject {
  id               String            @id @default(uuid())
  ownerId          String
  venueId          String
  name             String?
  status           SpaceLayoutStatus @default(DRAFT)
  photos           Json
  space            Json
  aiSuggestion     Json?
  savedLayout      Json?
  reviewSubmission Json?
  approvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([venueId])
  @@index([status])
  @@map("space_layout_projects")
}

model VenueDocumentRequest {
  id          String              @id @default(uuid())
  ownerId     String
  venueId     String
  status      VenueDocumentStatus @default(PENDING_REVIEW)
  documents   Json
  ownerNotes  String?
  reviewNotes String?
  submittedAt DateTime            @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([venueId])
  @@index([status])
  @@map("venue_document_requests")
}

model Reservation {
  id                    String            @id @default(uuid())
  venueId               String
  customerId            String?
  tableId               String
  tableLabel            String?
  roomLabel             String?
  type                  ReservationType   @default(ADVANCE)
  status                ReservationStatus @default(REQUESTED)
  partySize             Int
  timeSlotStart         DateTime
  timeSlotEnd           DateTime
  checkInOpensAt        DateTime?
  checkInClosesAt       DateTime?
  checkInReminderSentAt DateTime?
  arrivalDeadlineAt     DateTime?
  confirmationExpiresAt DateTime?
  confirmedAt           DateTime?
  declinedAt            DateTime?
  customerCheckedInAt   DateTime?
  checkedInAt           DateTime?
  seatedAt              DateTime?
  cancelledAt           DateTime?
  releasedAt            DateTime?
  feeCents              Int               @default(0)
  refundCents           Int               @default(0)
  currency              String            @default("EUR")
  userLatitude          Float?
  userLongitude         Float?
  distanceMeters        Float?
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  notes                 String?
  source                String            @default("user-app")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  venue                  Venue                      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customer               User?                      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments               ReservationPayment[]
  ledgerEntries          LedgerEntry[]
  refundRequests         VenueRefundRequest[]
  customerProblemReports CustomerProblemReport[]
  refundEvents           ReservationPaymentRefund[]

  @@index([venueId])
  @@index([customerId])
  @@index([tableId])
  @@index([status])
  @@index([timeSlotStart])
  @@index([timeSlotEnd])
  @@index([confirmationExpiresAt])
  @@index([venueId, tableId, timeSlotStart, timeSlotEnd])
  @@map("reservations")
}

model ReservationPayment {
  id                        String                   @id @default(uuid())
  reservationId             String
  venueId                   String
  customerId                String?
  paymentMethodId           String?
  provider                  PaymentProvider          @default(WORLDLINE)
  status                    ReservationPaymentStatus @default(AUTH_PENDING)
  amountCents               Int
  capturedCents             Int                      @default(0)
  refundedCents             Int                      @default(0)
  currency                  String                   @default("EUR")
  providerPaymentId         String?
  providerCheckoutId        String?
  providerMerchantReference String?                  @unique
  checkoutUrl               String?
  checkoutExpiresAt         DateTime?
  authorizedAt              DateTime?
  capturedAt                DateTime?
  voidedAt                  DateTime?
  failedAt                  DateTime?
  rawProviderData           Json?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  reservation               Reservation                @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  venue                     Venue                      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customer                  User?                      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethod             CustomerPaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  ledgerEntries             LedgerEntry[]
  refundRequests            VenueRefundRequest[]
  customerProblemReports    CustomerProblemReport[]
  reservationPaymentRefunds ReservationPaymentRefund[]

  @@index([reservationId])
  @@index([venueId])
  @@index([customerId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([providerPaymentId])
  @@map("reservation_payments")
}

model ReservationPaymentRefund {
  id                          String          @id @default(uuid())
  reservationId               String
  paymentId                   String
  venueId                     String
  customerId                  String?
  provider                    PaymentProvider @default(WORLDLINE)
  amountCents                 Int
  currency                    String          @default("EUR")
  reason                      String
  providerPaymentId           String?
  providerRefundTransactionId String?
  providerStatus              String?
  rawProviderData             Json?
  createdAt                   DateTime        @default(now())

  payment     ReservationPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reservation Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  venue       Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customer    User?              @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([paymentId])
  @@index([venueId])
  @@index([providerPaymentId])
  @@index([providerRefundTransactionId])
  @@map("reservation_payment_refunds")
}

model CustomerPaymentMethod {
  id                      String                      @id @default(uuid())
  customerId              String
  provider                PaymentProvider             @default(WORLDLINE)
  status                  CustomerPaymentMethodStatus @default(ACTIVE)
  providerPaymentMethodId String                      @unique
  brand                   String?
  last4                   String?
  expiryMonth             Int?
  expiryYear              Int?
  holderName              String?
  isDefault               Boolean                     @default(false)
  rawProviderData         Json?
  lastUsedAt              DateTime?
  disabledAt              DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  customer User                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments ReservationPayment[]

  @@index([customerId])
  @@index([provider])
  @@index([status])
  @@map("customer_payment_methods")
}

model LedgerEntry {
  id            String               @id @default(uuid())
  reservationId String?
  paymentId     String?
  venueId       String?
  customerId    String?
  payoutBatchId String?
  type          LedgerEntryType
  direction     LedgerEntryDirection
  amountCents   Int
  currency      String               @default("EUR")
  description   String?
  metadata      Json?
  createdAt     DateTime             @default(now())

  reservation Reservation?        @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  payment     ReservationPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  venue       Venue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)
  customer    User?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payoutBatch VenuePayoutBatch?   @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([paymentId])
  @@index([venueId])
  @@index([customerId])
  @@index([payoutBatchId])
  @@index([type])
  @@map("ledger_entries")
}

model VenueRefundRequest {
  id                    String                   @id @default(uuid())
  reservationId         String
  paymentId             String?
  venueId               String
  requestedByOwnerId    String?
  status                VenueRefundRequestStatus @default(PENDING)
  problemDescription    String
  resolutionAmountCents Int?
  resolutionCurrency    String?
  adminNotes            String?
  resolvedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  reservation      Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  payment          ReservationPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  venue            Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  requestedByOwner User?               @relation(fields: [requestedByOwnerId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([paymentId])
  @@index([venueId])
  @@index([requestedByOwnerId])
  @@index([status])
  @@map("venue_refund_requests")
}

model CustomerProblemReport {
  id                    String                      @id @default(uuid())
  reservationId         String
  paymentId             String?
  venueId               String
  customerId            String?
  status                CustomerProblemReportStatus @default(PENDING)
  problemDescription    String
  photo                 Json
  resolutionAmountCents Int?
  resolutionCurrency    String?
  adminNotes            String?
  resolvedAt            DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  reservation Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  payment     ReservationPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  venue       Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customer    User?               @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([paymentId])
  @@index([venueId])
  @@index([customerId])
  @@index([status])
  @@map("customer_problem_reports")
}

model PaymentWebhookEvent {
  id              String               @id @default(uuid())
  provider        PaymentProvider      @default(WORLDLINE)
  providerEventId String?
  eventType       String?
  status          PaymentWebhookStatus @default(RECEIVED)
  payload         Json
  processedAt     DateTime?
  error           String?
  createdAt       DateTime             @default(now())

  @@unique([provider, providerEventId])
  @@index([provider])
  @@index([status])
  @@map("payment_webhook_events")
}

model VenuePayoutBatch {
  id               String            @id @default(uuid())
  venueId          String
  status           VenuePayoutStatus @default(PENDING)
  periodStart      DateTime
  periodEnd        DateTime
  grossCents       Int               @default(0)
  chinChinFeeCents Int               @default(0)
  venueShareCents  Int               @default(0)
  currency         String            @default("EUR")
  notes            String?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  venue   Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@index([venueId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("venue_payout_batches")
}

model VenueReservationPenalty {
  id            String   @id @default(uuid())
  venueId       String
  reservationId String?
  monthKey      String
  reason        String
  notes         String?
  createdAt     DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([reservationId])
  @@index([venueId, monthKey])
  @@map("venue_reservation_penalties")
}

model VenueChinChinPanel {
  id                String   @id @default(uuid())
  venueId           String   @unique
  promotionalDrinks Json
  hasDraftBeer      Boolean  @default(false)
  draftBeers        Json
  hasEvent          Boolean  @default(false)
  events            Json?
  eventDay          String?
  eventStartsAt     String?
  eventBand         String?
  eventContent      Json?
  eventDescription  String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([hasEvent])
  @@map("venue_chin_chin_panels")
}

model DrinkBrand {
  id           String         @id @default(uuid())
  name         String
  brandKey     String         @unique
  type         DrinkBrandType
  aliases      Json
  logoAssetKey String?
  logoUrl      String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("drink_brands")
}

model ChinChinContentAsset {
  id           String              @id @default(uuid())
  name         String
  contentKey   String              @unique
  type         ChinChinContentType
  aliases      Json
  logoAssetKey String?
  logoUrl      String?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("chin_chin_content_assets")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PhoneVerificationCode {
  id          String    @id @default(uuid())
  userId      String
  phoneNumber String
  codeHash    String    @unique
  attempts    Int       @default(0)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phoneNumber])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("phone_verification_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}
