// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VENUE_OWNER
  STAFF
  ADMIN
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  DISABLED
}

enum SpaceLayoutStatus {
  DRAFT
  AI_SUGGESTED
  SAVED
  PENDING_CHIN_CHIN_REVIEW
  CHIN_CHIN_CHANGES_REQUESTED
  APPROVED
}

enum VenueDocumentStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  phoneNumber     String?
  role            UserRole   @default(VENUE_OWNER)
  status          UserStatus @default(PENDING_EMAIL_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  venues                  Venue[]
  emailVerificationTokens EmailVerificationToken[]
  refreshTokens           RefreshToken[]
  spaceLayoutProjects     SpaceLayoutProject[]
  venueDocumentRequests   VenueDocumentRequest[]

  @@index([status])
  @@map("users")
}

model Venue {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  slug      String   @unique
  address   String?
  city      String?
  country   String   @default("HR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spaceLayoutProjects   SpaceLayoutProject[]
  documentRequests      VenueDocumentRequest[]

  @@index([ownerId])
  @@map("venues")
}

model SpaceLayoutProject {
  id               String            @id @default(uuid())
  ownerId          String
  venueId          String
  name             String?
  status           SpaceLayoutStatus @default(DRAFT)
  photos           Json
  space            Json
  aiSuggestion     Json?
  savedLayout      Json?
  reviewSubmission Json?
  approvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([venueId])
  @@index([status])
  @@map("space_layout_projects")
}

model VenueDocumentRequest {
  id          String              @id @default(uuid())
  ownerId     String
  venueId     String
  status      VenueDocumentStatus @default(PENDING_REVIEW)
  documents   Json
  ownerNotes  String?
  reviewNotes String?
  submittedAt DateTime            @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([venueId])
  @@index([status])
  @@map("venue_document_requests")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}
